{
  "name": "hive-channel",
  "version": "0.9.5",
  "description": "hive per-pane message channel for Claude panes (transport only).",
  "author": {
    "name": "notdp",
    "url": "https://github.com/notdp"
  },
  "mcpServers": {
    "hive-channel": {
      "type": "stdio",
      "command": "hive",
      "args": [
        "claude",
        "channel-server"
      ]
    }
  },
  "channels": [
    {
      "server": "hive-channel"
    }
  ]
}
