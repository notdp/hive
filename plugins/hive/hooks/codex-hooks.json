{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap.sh\" >/dev/null",
            "timeout": 600,
            "statusMessage": "hive bootstrap check..."
          }
        ]
      }
    ]
  }
}
