{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GROK_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/bootstrap.py\"",
            "timeout": 600,
            "statusMessage": "hive bootstrap check..."
          }
        ]
      }
    ]
  }
}
